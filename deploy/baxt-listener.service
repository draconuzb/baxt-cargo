# Telegram guruhlarini tinglash (Telethon user session).
#
#   sudo cp deploy/baxt-listener.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now baxt-listener
#
# MUHIM: birinchi marta `python main.py listen` ni QO'LDA ishga tushiring —
# Telegram telefon raqam va kod so'raydi. Sessiya yaratilgandan keyingina
# servis sifatida qo'ying.

[Unit]
Description=BAXT TRANSPORT — Telegram cargo listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=baxt
WorkingDirectory=/opt/baxt_cargo
EnvironmentFile=/opt/baxt_cargo/.env
ExecStart=/opt/baxt_cargo/.venv/bin/python main.py listen
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

# Sirlarni himoya qilish: .session fayli = Telegram akkauntga to'liq kirish
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
