# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Dispetcher boti (@BotFather) ---
BOT_TOKEN=123456:AA...
# Chatni bo'sh qoldirsangiz — botga /start yozgan birinchi chat avtomatik
# ro'yxatga olinadi (chat id ni qo'lda qidirish shart emas). Bir nechta
# dispetcher bo'lsa hammasi /start yozadi.
DISPATCHER_CHAT_ID=
# Bot "🌐 Панель" tugmasi shu manzilni parolsiz ochadi (magic-havola):
PANEL_URL=https://trans.bizdaoson.uz

# --- Veb-panel (python main.py web) ---
# Majburiy: parolsiz panel ishga tushmaydi
WEB_PASSWORD=
# Sessiya imzosi uchun uzun tasodifiy satr (bo'sh bo'lsa paroldan olinadi)
# WEB_SECRET=
# Sukut: faqat shu kompyuter. Tashqariga ochishdan oldin README ni o'qing
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# Ruxsat etilgan IP'lar (vergul bilan), masalan VPN manzillari
# WEB_ALLOWED_IPS=10.8.0.2,10.8.0.3
# HTTPS ortida ishlasa: 1
# WEB_SECURE_COOKIE=1

# --- Bildirishnomalar ---
# Soatiga ko'pi bilan nechta kartochka (qolgani yig'ma xabarda)
# MAX_NOTIFY_PER_HOUR=10

# --- GPS treker (Wialon / Wialon Local) ---
# Wialon Local bo'lsa — o'z serveringiz manzili ("/wialon/ajax.html" o'zi qo'shiladi):
# WIALON_URL=https://gpsmonitor.uz
# WIALON_TOKEN=
# Trekerlar mashinaga nomi (davlat raqami) bo'yicha avtomatik bog'lanadi.
# Bog'lanmaganlari uchun qo'lda: treker id -> mashina raqami.
# Ro'yxatni ko'rish: python main.py wialon
# WIALON_UNITS={"12345": "01", "12346": "02"}
# WIALON_TIMEOUT=15

# --- AI yurak (brain.py): rahbar botga oddiy gap bilan yozadi ---
# Bepul rejalar: console.mistral.ai va console.groq.com -> API Keys.
# Tartib = ustuvorlik; biri limitga yetsa yoki ishlamasa — keyingisi.
# AI_PROVIDERS=groq,mistral
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# Model nomlari o'zgarib turadi — kerak bo'lsa almashtiring:
# AI_MODEL_MISTRAL=ministral-14b-latest,ministral-8b-latest
# AI_MODEL_GROQ=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Kunlik so'rovlar chegarasi (bitta savol = 2–4 so'rov):
# AI_MAX_CALLS_PER_DAY=600
# Panelga Telegram orqali kira oladigan qo'shimcha foydalanuvchilar (id, vergul bilan).
# Sukut: botga /start yozgan dispetcherlar.
# WEB_TG_USERS=

# --- LLM (ixtiyoriy): regex tushunmagan chalkash e'lonlar uchun ---
# Xabarlarning ~5% i modelga tushadi, javoblar keshlanadi.
# Variantlar: ollama (o'z serveringizda, bepul) | mistral | groq |
#             openrouter | anthropic | none
# LLM_PROVIDER=none
# LLM_API_KEY=
# Model nomlari o'zgarib turadi — provayder hujjatidan tekshiring:
# LLM_MODEL=
# O'z serveringiz yoki boshqa OpenAI-mos xizmat bo'lsa:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# Kunlik so'rovlar chegarasi (xarajat nazorati):
# LLM_MAX_CALLS_PER_DAY=300
# LLM_TIMEOUT=20

# --- Ixtiyoriy ---
# OSRM_URL=http://127.0.0.1:5000
# Eski sozlama (LLM_PROVIDER berilmasa ishlatiladi):
# ANTHROPIC_API_KEY=sk-ant-...
# DB_PATH=/var/lib/baxt/cargo.db
# LOG_DIR=/var/log/baxt
# LOG_LEVEL=INFO
